# ============================================
# Database (Supabase PostgreSQL)
# ============================================
# IMPORTANT: Supabase utilise deux types de connexions :
#
# 1. DATABASE_URL (Connection Pooling) - Pour l'application
#    Port 6543 avec pgbouncer=true
#    Utilisé par l'API et le redirect service
#
# 2. DIRECT_URL (Connexion directe) - Pour les migrations Prisma
#    Port 5432 (connexion directe)
#    Utilisé uniquement par Prisma migrate (pgbouncer ne supporte pas les migrations)
#
# Récupérez ces URLs depuis Supabase Dashboard > Project Settings > Database
# ============================================

# Connection pooling (pour l'application)
DATABASE_URL="postgresql://postgres.dwexipiunzmtdgkiwofd:[YOUR-PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (pour les migrations Prisma)
DIRECT_URL="postgresql://postgres.dwexipiunzmtdgkiwofd:[YOUR-PASSWORD]@aws-1-eu-central-2.pooler.supabase.com:5432/postgres"

# ============================================
# Supabase (Optional for Phase 1, required for Phase 2)
# ============================================
# Get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ============================================
# Security & Hashing
# ============================================
# Generate with: openssl rand -base64 32
CLICK_COOKIE_SECRET="[GENERATE-A-32-BYTE-SECRET]"
HASH_SALT="[GENERATE-A-STRONG-SALT]"

# ============================================
# Server Ports
# ============================================
API_PORT=4000
REDIRECT_PORT=4100

# ============================================
# Test IDs (for E2E scripts)
# ============================================
# These will be created when you run migrations and seed data
# TEST_WORKSPACE_ID="clx..."
# TEST_DOMAIN_ID="clx..."

# ============================================
# Shopify App Configuration
# ============================================
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_orders,write_script_tags"
SHOPIFY_APP_URL="https://your-app-url.com"
SHOPIFY_APP_PORT=3001
SHOPIFY_WORKSPACE_ID="" # Workspace ID par défaut pour les shops Shopify
